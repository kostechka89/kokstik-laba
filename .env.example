# --- Runtime ---
MEXC_BASE_URL=https://contract.mexc.com
SCAN_INTERVAL_SEC=20

# --- Universe / liquidity filters ---
MIN_24H_VOLUME_USDT=3000000
MAX_24H_VOLUME_USDT=10000000000
MAX_PRICE=250
PAIR_LIMIT=80

# --- Anti-noise ---
COOLDOWN_MIN=12
VR_MAX_FILTER=5.8
RET15_MAX_FILTER=15.0

# --- Optional Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- DB path inside container ---
DB_PATH=/app/data/signals.db
